<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests run on MariaDB with the upstream schema fixture and on a real Redis (constitution VII).
  Run them through `composer test`, which bundles the contract and prepares the database first.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <extensions>
        <!-- T018: the contract coverage extension is registered here. -->
    </extensions>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
