# Test environment (phpunit.xml forces APP_ENV=testing). Laravel loads only this file in tests,
# so it is complete. The key is a test-only key and protects nothing.
APP_NAME="mailcow REST API v2"
APP_ENV=testing
APP_KEY=base64:hW6HlSsgz/DAoakPkuxVy2vVfyG5YsQMjrSxVhZVV9M=
APP_DEBUG=false

LOG_LEVEL=debug

DBHOST=mariadb
DBNAME=restv2_test
DBUSER=mailcow
DBPASS=mailcow
REDISHOST=redis
REDISPASS=devredispass
REDIS_DB=15

MAILCOW_HOSTNAME=mail.example.org
SKIP_SOGO=n
# Differs from UTC on purpose, so that the conversion of mailcow's local times is exercised.
TZ=Europe/Prague

RESTV2_MAILCOW_INC_DIR=tests/fixtures/mailcow-inc

# Feature 002: dockerapi container lookup and the upstream default DKIM selector.
COMPOSE_PROJECT_NAME=mailcowdockerized
RESTV2_DEFAULT_DKIM_SELECTOR=dkim
LOG_STREAM=storage/logs/testing.log

# Feature 003: mailboxes (mailcow.conf names).
MAILCOW_PASS_SCHEME=BLF-CRYPT
MAILDIR_GC_TIME=7200
MASTER=y

# Feature 011: monitoring and operations. The dockerapi fixtures use the compose project above.
LOG_LINES=9999
SKIP_CLAMD=n
SKIP_OLEFY=n
IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64
RESTV2_UPDATE_CHECK=y
HOSTNAME=
