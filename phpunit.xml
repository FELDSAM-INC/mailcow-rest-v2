<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests run on MariaDB with the upstream schema fixture and on a real Redis (constitution VII).
  Run them through `composer test`, which bundles the contract and prepares the database first.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <!--
      Timing tests (#[Group('performance')]) measure wall-clock budgets and fail on a loaded machine,
      so `composer test` leaves them out. `composer test:performance` runs them on their own.
      Group idp needs the OpenLDAP service of the dev stack's idp profile (feature 012, quickstart
      Part A): start it, then run phpunit with the option group idp.
    -->
    <groups>
        <exclude>
            <group>performance</group>
            <group>idp</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <extensions>
        <bootstrap class="Tests\Support\Contract\ContractCoverageExtension"/>
    </extensions>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <ini name="memory_limit" value="1G"/>
    </php>
</phpunit>
