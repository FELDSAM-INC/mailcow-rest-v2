{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "feldsam-inc/mailcow-rest-v2",
    "type": "project",
    "description": "Contract-first REST API v2 for mailcow-dockerized",
    "keywords": [
        "mailcow",
        "rest-api",
        "openapi",
        "laravel"
    ],
    "license": [
        "GPL-3.0-only"
    ],
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "lbuchs/webauthn": "^2.2",
        "league/oauth2-client": "^2.8",
        "mlocati/spf-lib": "^3.3",
        "php-mime-mail-parser/php-mime-mail-parser": "^10.0",
        "robthree/twofactorauth": "^3.0",
        "soundasleep/html2text": "^2.1",
        "symfony/mime": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "bshaffer/oauth2-server-php": "1.11.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "resources/legacy/sieve/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "contract:lint": [
            "npx --yes @redocly/cli@2.64.1 lint api/openapi.yaml"
        ],
        "contract:bundle": [
            "npx --yes @redocly/cli@2.64.1 bundle api/openapi.yaml --output build/contract/openapi.yaml",
            "npx --yes @redocly/cli@2.64.1 bundle api/openapi.yaml --dereferenced --ext json --output build/contract/openapi.json"
        ],
        "docs:assets": [
            "rm -rf build/swagger-ui && mkdir -p build/swagger-ui resources/docs",
            "cd build/swagger-ui && npm pack --silent swagger-ui-dist@5.33.0 >/dev/null && tar -xzf swagger-ui-dist-5.33.0.tgz",
            "cp build/swagger-ui/package/swagger-ui.css build/swagger-ui/package/swagger-ui-bundle.js build/swagger-ui/package/LICENSE resources/docs/"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@contract:bundle",
            "tests/bin/prepare-database.sh restv2_test @no_additional_args",
            "@php vendor/bin/phpunit",
            "@php tests/bin/check-contract-coverage.php @no_additional_args"
        ],
        "test:performance": [
            "Composer\\Config::disableProcessTimeout",
            "@contract:bundle",
            "tests/bin/prepare-database.sh restv2_test @no_additional_args",
            "@php vendor/bin/phpunit --group performance"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G"
        ],
        "format": [
            "pint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "contract:lint": "Lint the OpenAPI contract with Redocly.",
        "contract:bundle": "Bundle the contract to build/contract/openapi.yaml and dereferenced openapi.json.",
        "test": "Bundle the contract, prepare the MariaDB test database, run PHPUnit and check contract coverage.",
        "test:performance": "Run the timing tests (group performance) alone, on an otherwise idle machine.",
        "analyse": "Run Larastan (PHPStan).",
        "format": "Format the code with Pint.",
        "docs:assets": "Copy the Swagger UI assets (swagger-ui-dist, Apache-2.0) into resources/docs/ for the documentation page."
    }
}
