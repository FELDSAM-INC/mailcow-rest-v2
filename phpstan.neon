# Static analysis gate (constitution quality gate 6, research R25).
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - tests
        - config
        - routes
        - database
        - bootstrap/app.php
    tmpDir: storage/framework/cache/phpstan
    # Symbols of the excluded legacy fixtures that tests call (legacy_verify_hash()).
    scanFiles:
        - tests/fixtures/legacy/verify_hash.php
        - tests/fixtures/legacy/syncjob_validation.php
    ignoreErrors:
        # Feature 007: field-error assertions that Tests\Support\Accounts\AccountTestHelpers
        # registers as TestResponse macros in its setUp (Larastan sees only boot-time macros).
        -
            message: '#^Call to an undefined method Illuminate\\Testing\\TestResponse(<.*>)?::assertViolation(Params)?\(\)\.$#'
            path: tests/*
    excludePaths:
        # Legacy code copied verbatim from mailcow (tests/fixtures/legacy) and mailcow's vars files.
        - tests/fixtures/*
