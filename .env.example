# Dev stack defaults (compose.yaml). Copy to .env and run `php artisan key:generate`.
APP_NAME="mailcow REST API v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=false

LOG_LEVEL=debug

# mailcow.conf names (research R14)
DBHOST=mariadb
DBNAME=mailcow
DBUSER=mailcow
DBPASS=mailcow
REDISHOST=redis
REDISPASS=devredispass
MAILCOW_HOSTNAME=localhost
SKIP_SOGO=n
# Feature 007: webmail login on behalf of a user (mailcow.conf name, default n).
ALLOW_ADMIN_EMAIL_LOGIN=n
TZ=Europe/Prague

# The session cookie keeps its production name (__Host-restv2_session): it is always Secure, so
# use the dev stack's HTTPS listener, https://127.0.0.1:18443 (self-signed, `curl -k`).

# Mount point of mailcow's data/web/inc; empty means not mounted (upstream defaults apply).
RESTV2_MAILCOW_INC_DIR=

# Feature 002: the dev stack has no dockerapi, memcached or ISPConfig, so stand-ins are bound
# (development only). COMPOSE_PROJECT_NAME (mailcow's compose project, for the dockerapi container
# lookup) is not set here: Docker Compose would read it from this file as the dev stack's own
# project name.
RESTV2_FAKE_OUTBOUND=y

# Feature 003: mailboxes (mailcow.conf names).
MAILCOW_PASS_SCHEME=BLF-CRYPT
MAILDIR_GC_TIME=7200
MASTER=y

# Feature 004: an empty value reads ALIAS_DISABLE_EXTERNAL_DOMAINS from mailcow's vars files
# (upstream default false); true or false always wins.
RESTV2_ALIAS_DISABLE_EXTERNAL_DOMAINS=

# Feature 011 (monitoring and operations, research R27). With RESTV2_FAKE_OUTBOUND=y the dev stack
# serves the recorded payloads of tests/fixtures/monitoring/ instead of dockerapi, Rspamd, the
# release source and the IP check service.
LOG_LINES=9999
SKIP_CLAMD=n
SKIP_OLEFY=n
RESTV2_SELF_SERVICE=restv2-mailcow
RESTV2_PROTECTED_CONTAINERS=dockerapi-mailcow,mysql-mailcow,redis-mailcow,nginx-mailcow,restv2-mailcow
RESTV2_CONTAINER_ROLES={}
RESTV2_POSTFIX_CONTAINER=postfix-mailcow
RESTV2_DOVECOT_CONTAINER=dovecot-mailcow
RESTV2_BAN_SERVICE_CONTAINER=netfilter-mailcow
RESTV2_UPDATE_CHECK=y
RESTV2_UPDATE_SOURCE_URL=
RESTV2_UPDATE_STABLE_BRANCH=master
RESTV2_IP_CHECK_IPV4_URL=http://ipv4.mailcow.email
RESTV2_IP_CHECK_IPV6_URL=http://ipv6.mailcow.email
RESTV2_RSPAMD_SOCKET=/var/lib/rspamd/rspamd.sock

# Feature 006: quarantine, spam policy and rate limits. The Rspamd controller (learning, fuzzy
# hashes, thresholds, statistics) times out after RESTV2_RSPAMD_TIMEOUT seconds; releases go to
# Postfix's quarantine submission. The dev stack has neither: start the SMTP sink with
# `docker compose --profile mail up -d mailpit` and set RESTV2_RELEASE_SMTP_HOST=mailpit and
# RESTV2_RELEASE_SMTP_PORT=1025. The default notification template is read from
# RESTV2_MAILCOW_TPLS_DIR/quarantine.tpl unless RESTV2_QUARANTINE_DEFAULT_TEMPLATE names another file.
RESTV2_RSPAMD_TIMEOUT=30
RESTV2_RELEASE_SMTP_HOST=postfix
RESTV2_RELEASE_SMTP_PORT=590
RESTV2_RELEASE_SMTP_TIMEOUT=30
RESTV2_QUARANTINE_CONTENT_LIMIT=10485760
RESTV2_QUARANTINE_DEFAULT_TEMPLATE=
RESTV2_TEMPLATE_RENDER_TIMEOUT=5

# Feature 008: sync jobs. An empty RESTV2_IMAPSYNC_OPTIONS reads $IMAPSYNC_OPTIONS from mailcow's
# vars files (upstream default list); a JSON object {"whitelist": [...], "blacklist": [...]} always
# wins. showpasswords is never accepted. RESTV2_SYNC_JOBS_CUSTOM_PARAMS_ADMIN_ONLY=y restricts custom
# imapsync parameters to administrators; RESTV2_SYNC_JOBS_BULK_LIMIT lowers the bulk limit (1-100).
#RESTV2_IMAPSYNC_OPTIONS=
#RESTV2_SYNC_JOBS_CUSTOM_PARAMS_ADMIN_ONLY=n
#RESTV2_SYNC_JOBS_BULK_LIMIT=100

# Feature 012: the dev stack serves the new web app over plain HTTP, so single sign-on return
# addresses use http (development only).
RESTV2_SSO_RETURN_SCHEME=http

# Feature 009: defaults of the relayhost and transport connection test (legacy values), and its
# step and total timeouts in seconds. Invalid values fall back to these defaults with a warning.
RESTV2_ROUTING_TEST_SENDER=relay@example.org
RESTV2_ROUTING_TEST_RECIPIENT=null@hosted.mailcow.de
RESTV2_ROUTING_TEST_STEP_TIMEOUT=15
RESTV2_ROUTING_TEST_TOTAL_TIMEOUT=60

# Feature 010: DKIM, MTA-STS and DNS diagnostics. An empty RESTV2_SHOW_DKIM_PRIV_KEYS or
# RESTV2_AUTODISCOVER_CONFIG reads $SHOW_DKIM_PRIV_KEYS and $autodiscover_config from mailcow's vars
# files (upstream: no export; the ports of the mailcow.conf port variables). The dev stack declares
# documentation addresses as its public addresses, so that diagnostics never asks the echo service;
# empty values ask it, and RESTV2_PUBLIC_IPV6=none declares no IPv6. FeldHost:
# RESTV2_DEFAULT_DKIM_SELECTOR=feldhost, RESTV2_SUGGESTED_SPF_RECORD="v=spf1 mx a ~all" and the
# ISPConfig DKIM publication (RESTV2_DKIM_DNS_PUBLICATION=y with RESTV2_ISPCONFIG_*).
RESTV2_SHOW_DKIM_PRIV_KEYS=
RESTV2_AUTODISCOVER_CONFIG=
RESTV2_DKIM_BULK_PUBLICATION_BUDGET=60
RESTV2_DNS_LOOKUP_TIMEOUT=5
RESTV2_DNS_RUN_TIMEOUT=30
RESTV2_DNS_DIAGNOSTICS_PER_MINUTE=10
RESTV2_DNS_FACTS_TTL=600
RESTV2_PUBLIC_IPV4=198.51.100.7
RESTV2_PUBLIC_IPV6=2001:db8::7
RESTV2_IP_ECHO_URL_IPV4=http://ip4.mailcow.email
RESTV2_IP_ECHO_URL_IPV6=http://ip6.mailcow.email
RESTV2_SUGGESTED_SPF_RECORD=

# Feature 013: system settings. DEMO_MODE is mailcow.conf's name (y refuses branding changes).
# The shared mailcow files: the editable Rspamd maps, the two global Sieve files and the language
# files. The dev stack has no mailcow, so quickstart Part B copies the fixtures of
# tests/fixtures/mailcow/ to storage/dev-mailcow/ first. The default templates are feature 005's
# RESTV2_MAILCOW_TPLS_DIR. License verification is upstream behaviour; FeldHost sets it to false.
DEMO_MODE=n
RESTV2_RSPAMD_MAP_DIR=storage/dev-mailcow/rspamd_custom_maps
RESTV2_GLOBAL_SIEVE_DIR=storage/dev-mailcow/global_sieve
RESTV2_MAILCOW_LANG_DIR=tests/fixtures/mailcow/lang
RESTV2_RSPAMD_SETTINGS_MAP_URL=http://nginx:8081/settings.php
RESTV2_RSPAMD_UI_URL=/rspamd/
RESTV2_LMTP_HOST=dovecot-mailcow
RESTV2_LMTP_PORT=24
RESTV2_MASS_MAIL_RATE=10
RESTV2_MASS_MAIL_DELIVERY_DEADLINE=5
RESTV2_LICENSE_VERIFICATION=true
RESTV2_LICENSE_VERIFY_URL=https://verify.mailcow.email
# Empty: mailcow's vars files ($LOGO_LIMITS, $RSPAMD_MAPS), then the upstream defaults.
RESTV2_LOGO_LIMITS=
RESTV2_RSPAMD_MAPS=
