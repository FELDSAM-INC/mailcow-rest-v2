# Dev stack defaults (compose.yaml). Copy to .env and run `php artisan key:generate`.
APP_NAME="mailcow REST API v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=false

LOG_LEVEL=debug

# mailcow.conf names (research R14)
DBHOST=mariadb
DBNAME=mailcow
DBUSER=mailcow
DBPASS=mailcow
REDISHOST=redis
REDISPASS=devredispass
MAILCOW_HOSTNAME=localhost
SKIP_SOGO=n
TZ=Europe/Prague

# The session cookie keeps its production name (__Host-restv2_session): it is always Secure, so
# use the dev stack's HTTPS listener, https://127.0.0.1:18443 (self-signed, `curl -k`).

# Mount point of mailcow's data/web/inc; empty means not mounted (upstream defaults apply).
RESTV2_MAILCOW_INC_DIR=

# Feature 002: the dev stack has no dockerapi, memcached or ISPConfig, so stand-ins are bound
# (development only). COMPOSE_PROJECT_NAME (mailcow's compose project, for the dockerapi container
# lookup) is not set here: Docker Compose would read it from this file as the dev stack's own
# project name.
RESTV2_FAKE_OUTBOUND=y

# Feature 003: mailboxes (mailcow.conf names).
MAILCOW_PASS_SCHEME=BLF-CRYPT
MAILDIR_GC_TIME=7200
MASTER=y

# Feature 004: an empty value reads ALIAS_DISABLE_EXTERNAL_DOMAINS from mailcow's vars files
# (upstream default false); true or false always wins.
RESTV2_ALIAS_DISABLE_EXTERNAL_DOMAINS=

# Feature 011 (monitoring and operations, research R27). With RESTV2_FAKE_OUTBOUND=y the dev stack
# serves the recorded payloads of tests/fixtures/monitoring/ instead of dockerapi, Rspamd, the
# release source and the IP check service.
LOG_LINES=9999
SKIP_CLAMD=n
SKIP_OLEFY=n
RESTV2_SELF_SERVICE=restv2-mailcow
RESTV2_PROTECTED_CONTAINERS=dockerapi-mailcow,mysql-mailcow,redis-mailcow,nginx-mailcow,restv2-mailcow
RESTV2_CONTAINER_ROLES={}
RESTV2_POSTFIX_CONTAINER=postfix-mailcow
RESTV2_DOVECOT_CONTAINER=dovecot-mailcow
RESTV2_BAN_SERVICE_CONTAINER=netfilter-mailcow
RESTV2_UPDATE_CHECK=y
RESTV2_UPDATE_SOURCE_URL=
RESTV2_UPDATE_STABLE_BRANCH=master
RESTV2_IP_CHECK_IPV4_URL=http://ipv4.mailcow.email
RESTV2_IP_CHECK_IPV6_URL=http://ipv6.mailcow.email
RESTV2_RSPAMD_SOCKET=/var/lib/rspamd/rspamd.sock

# Feature 008: sync jobs. An empty RESTV2_IMAPSYNC_OPTIONS reads $IMAPSYNC_OPTIONS from mailcow's
# vars files (upstream default list); a JSON object {"whitelist": [...], "blacklist": [...]} always
# wins. showpasswords is never accepted. RESTV2_SYNC_JOBS_CUSTOM_PARAMS_ADMIN_ONLY=y restricts custom
# imapsync parameters to administrators; RESTV2_SYNC_JOBS_BULK_LIMIT lowers the bulk limit (1-100).
#RESTV2_IMAPSYNC_OPTIONS=
#RESTV2_SYNC_JOBS_CUSTOM_PARAMS_ADMIN_ONLY=n
#RESTV2_SYNC_JOBS_BULK_LIMIT=100
