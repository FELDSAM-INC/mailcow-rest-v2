# Test environment (phpunit.xml forces APP_ENV=testing). Laravel loads only this file in tests,
# so it is complete. The key is a test-only key and protects nothing.
APP_NAME="mailcow REST API v2"
APP_ENV=testing
APP_KEY=base64:hW6HlSsgz/DAoakPkuxVy2vVfyG5YsQMjrSxVhZVV9M=
APP_DEBUG=false

LOG_LEVEL=debug

DBHOST=mariadb
DBNAME=restv2_test
DBUSER=mailcow
DBPASS=mailcow
REDISHOST=redis
REDISPASS=devredispass
REDIS_DB=15

MAILCOW_HOSTNAME=mail.example.org
SKIP_SOGO=n
# Feature 007: webmail login on behalf of a user (mailcow.conf name, default n).
ALLOW_ADMIN_EMAIL_LOGIN=n
# Differs from UTC on purpose, so that the conversion of mailcow's local times is exercised.
TZ=Europe/Prague

RESTV2_MAILCOW_INC_DIR=tests/fixtures/mailcow-inc

# Feature 002: dockerapi container lookup and the upstream default DKIM selector.
COMPOSE_PROJECT_NAME=mailcowdockerized
RESTV2_DEFAULT_DKIM_SELECTOR=dkim
LOG_STREAM=storage/logs/testing.log

# Feature 003: mailboxes (mailcow.conf names).
MAILCOW_PASS_SCHEME=BLF-CRYPT
MAILDIR_GC_TIME=7200
MASTER=y

# Feature 011: monitoring and operations. The dockerapi fixtures use the compose project above.
LOG_LINES=9999
SKIP_CLAMD=n
SKIP_OLEFY=n
IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64
RESTV2_UPDATE_CHECK=y
HOSTNAME=

# Feature 012: host names of the single sign-on return addresses (mailcow.conf name).
ADDITIONAL_SERVER_NAMES=webmail.example.org,mail.example.net

# Feature 010: the public addresses are detected through the (faked) echo service; the service
# ports are mailcow's defaults (no port variables set).
RESTV2_PUBLIC_IPV4=
RESTV2_PUBLIC_IPV6=
RESTV2_SUGGESTED_SPF_RECORD=
RESTV2_SHOW_DKIM_PRIV_KEYS=

# Feature 005: account self-service. The reset message goes to the array mailer; the default reset
# templates are the upstream files.
MAIL_MAILER=array
RESTV2_MAILCOW_TPLS_DIR=tests/fixtures/mailcow-tpls
RESTV2_COUNTRY_LOOKUP=true

# Feature 013: system settings. The shared files live in a per-test sandbox
# (Tests\Support\Settings\SharedFilesSandbox) copied from tests/fixtures/mailcow/; the language
# files are read-only fixtures. The license service is faked with Http::fake().
DEMO_MODE=n
RESTV2_RSPAMD_MAP_DIR=storage/framework/testing/mailcow/rspamd_custom_maps
RESTV2_GLOBAL_SIEVE_DIR=storage/framework/testing/mailcow/global_sieve
RESTV2_MAILCOW_LANG_DIR=tests/fixtures/mailcow/lang
RESTV2_RSPAMD_SETTINGS_MAP_URL=http://nginx:8081/settings.php
RESTV2_LMTP_HOST=dovecot-mailcow
RESTV2_LMTP_PORT=24
RESTV2_MASS_MAIL_RATE=10
RESTV2_LICENSE_VERIFICATION=true
RESTV2_LOGO_LIMITS=
RESTV2_RSPAMD_MAPS=
